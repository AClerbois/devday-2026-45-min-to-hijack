<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DevDayChaos</RootNamespace>

    <!-- NuGet Audit : inspecte toutes les dépendances, y compris transitives -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>

    <!-- API marquées expérimentales par le SDK OpenAI et Microsoft.Extensions.AI : sans ça, erreur de compilation -->
    <NoWarn>$(NoWarn);OPENAI001;MEAI001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Composants Blazor AI : expérimentaux (preview), l'UI de chat agentique -->
    <PackageReference Include="Microsoft.AspNetCore.Components.AI" Version="0.1.0-preview.1.26466.103" />
    <!-- Le package ci-dessus tire Components.Web en 11.0.0-rc.1 : on garde celui du framework partagé .NET 11 -->
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="11.0.0" ExcludeAssets="all" NoWarn="NU1510;NU1605" />

    <PackageReference Include="Microsoft.Extensions.AI" Version="11.0.1" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="11.0.1" />
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
  </ItemGroup>

</Project>
